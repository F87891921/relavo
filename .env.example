# Kopier denne filen til .env.local og fyll inn verdiene fra
# Supabase-prosjektet ditt: Project Settings → API.
#
# NEXT_PUBLIC_-prefikset betyr at verdien blir synlig i nettleseren.
# Det er trygt for disse to spesifikt — tilgangen styres av Row Level
# Security i databasen, ikke av at nøkkelen holdes hemmelig.

NEXT_PUBLIC_SUPABASE_URL=https://ditt-prosjekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=din-anon-key

# Innlogging med Microsoft. Settes til "på" først når Azure-provideren er
# satt opp i Supabase (Authentication → Providers → Azure). Er den ikke det,
# sender Supabase kunden til en rå JSON-feilside — derfor er knappen av
# til det er på plass.
NEXT_PUBLIC_MICROSOFT_INNLOGGING=av

# Enkel sperre foran hele siden mens den ligger på et offentlig domene.
# Dette er ikke innlogging — den ekte innloggingen mot Supabase ligger bak.
# Er variabelen tom eller borte, er sperren av og siden er åpen.
SIDE_PASSORD=

# Utgående e-post. Uten denne sendes ingenting — grensesnittet sier det
# høyt i stedet for å påstå at et brev er sendt. Nøkkel fra resend.com.
RESEND_API_KEY=
EPOST_AVSENDER="Relavo <post@relavo.no>"

# Relavos egne opplysninger. Står på tilbudene kunden får. Mangler
# organisasjonsnummeret, sier tilbudsdokumentet fra i rødt.
NEXT_PUBLIC_RELAVO_ORG_NR=
NEXT_PUBLIC_RELAVO_ADRESSE=
NEXT_PUBLIC_RELAVO_EPOST=post@relavo.no

# Kortbetaling. Uten denne vises ingen kortvei — kunden får fakturavalget,
# og grensesnittet sier hvorfor. Nøkkel fra dashboard.stripe.com.
STRIPE_SECRET_KEY=

# Fortnox. Fakturaene skrives der og speiles hit, så ingen fører dem to
# ganger. Tokenene lagres i tabellen integrasjoner, ikke her — Fortnox
# bytter fornyelsestokenet hver time.
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
